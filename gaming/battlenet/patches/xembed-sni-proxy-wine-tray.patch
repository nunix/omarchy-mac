+
+    // Windows tray icons (via Wine/Proton) usually restore their window on a
+    // double-click, while SNI hosts send a single Activate. Turn it into a
+    // double-click; the clicks have to be spaced out or Wine won't pair them.
+    // The first double-click after the window was hidden gets swallowed, so
+    // send a second one; it's harmless when the window is already shown.
+    KWindowInfo window(m_windowId, NET::Properties(), NET::WM2WindowClass);
+    const QByteArray windowClass = window.windowClassClass().toLower();
+    if (windowClass.startsWith("steam_") || windowClass == "wine" || windowClass.endsWith(".exe")) {
+        for (int delay : {150, 600, 750}) {
+            QTimer::singleShot(delay, this, [this, x, y]() {
+                sendClick(XCB_BUTTON_INDEX_1, x, y);
+            });
+        }
+    }
 }
 
