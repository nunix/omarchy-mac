#!/bin/bash

# omarchy:hidden=true
# omarchy:summary=Switch through the five-workspace touchpad carousel
# omarchy:args=<next|previous>

set -euo pipefail

MAX_WORKSPACE=5

usage() {
  echo "Usage: omarchy-hyprland-workspace-carousel <next|previous>" >&2
}

if (($# != 1)); then
  usage
  exit 1
fi

direction="$1"
case "$direction" in
  next|previous) ;;
  *)
    usage
    exit 1
    ;;
esac

active_workspace=$(hyprctl activeworkspace -j)
current_workspace=$(jq -er '.id | numbers' <<<"$active_workspace")
monitor=$(jq -er '.monitor | strings' <<<"$active_workspace")

# Keep every occupied workspace, including a manually created workspace above
# the five-workspace limit. Within workspaces 1..5, add only the first empty
# slot after the last occupied workspace. This prevents a run of empty slots
# from making the carousel stop at the first one while still preserving one
# empty workspace for new windows.
mapfile -t carousel_workspaces < <(
  hyprctl workspaces -j | jq -r --arg monitor "$monitor" --argjson max "$MAX_WORKSPACE" '
    [
      .[]
      | select(
          .monitor == $monitor
          and (.id | type) == "number"
          and .id >= 1
          and (.windows // 0) > 0
        )
      | .id
    ]
    | unique as $occupied
    | ([1] + $occupied | unique) as $with_first
    | ([ $with_first[] | select(. <= $max) ] | max // 1) as $last_base
    | (
        if $last_base < $max and (($with_first | index($last_base + 1)) | not)
        then [$last_base + 1]
        else []
        end
      ) as $empty
    | ($with_first + $empty | unique | sort | .[])
  '
)

if ((${#carousel_workspaces[@]} == 0)); then
  carousel_workspaces=(1)
fi

current_index=-1
for index in "${!carousel_workspaces[@]}"; do
  if ((carousel_workspaces[index] == current_workspace)); then
    current_index=$index
    break
  fi
done

if ((current_index >= 0)); then
  if [[ $direction == next ]]; then
    target_index=$(((current_index + 1) % ${#carousel_workspaces[@]}))
  else
    target_index=$(((current_index - 1 + ${#carousel_workspaces[@]}) % ${#carousel_workspaces[@]}))
  fi
else
  # A manually selected empty workspace may not be in the carousel. Insert it
  # numerically without making it part of the persistent carousel state.
  target_index=-1
  if [[ $direction == next ]]; then
    for index in "${!carousel_workspaces[@]}"; do
      if ((carousel_workspaces[index] > current_workspace)); then
        target_index=$index
        break
      fi
    done
    ((target_index >= 0)) || target_index=0
  else
    for index in "${!carousel_workspaces[@]}"; do
      if ((carousel_workspaces[index] < current_workspace)); then
        target_index=$index
      fi
    done
    ((target_index >= 0)) || target_index=$((${#carousel_workspaces[@]} - 1))
  fi
fi

target_workspace=${carousel_workspaces[target_index]}
hyprctl dispatch "hl.dsp.focus({ workspace = \"$target_workspace\", on_current_monitor = true })"
